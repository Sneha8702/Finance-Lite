# Local development: use console.EmailBackend to print emails without sending.
# Use smtp.EmailBackend after replacing the Brevo placeholders below.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
DEFAULT_FROM_EMAIL="Finance Management <your-verified-sender@example.com>"
FRONTEND_URL=http://localhost:5173
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
