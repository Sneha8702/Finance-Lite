# Local development: use console.EmailBackend to print emails without sending.
# Use smtp.EmailBackend after replacing the Brevo placeholders below.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
DEFAULT_FROM_EMAIL="Finance Management <your-verified-sender@example.com>"
FRONTEND_URL=http://localhost:5173

# Production API host and browser security origins
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-backend-domain.com
CORS_ALLOWED_ORIGINS=https://finance-lite.vercel.app,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://finance-lite.vercel.app,http://localhost:5173

# PostgreSQL (set POSTGRES_DB to enable PostgreSQL; otherwise SQLite is used)
POSTGRES_DB=finance_management
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer
POSTGRES_CONN_MAX_AGE=60
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
